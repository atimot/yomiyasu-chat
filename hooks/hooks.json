{
  "description": "応答終了時に yomiyasu_lint で最終応答を検査し、スコアと指摘を通知する",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/yomiyasu_stop_hook.py\"",
            "timeout": 30,
            "statusMessage": "yomiyasu_lint で応答を検査中"
          }
        ]
      }
    ]
  }
}
